# 只跟踪源码、文档、配置和小型测试夹具。
# 大型资产（模型、音频、引擎、演示物）走仓外归档，路径由配置或环境变量给出。
# 例外必须在下方白名单中逐条写明，并说明用途。

# ---- 构建产物 ----
/build/
/build-*/
/cmake-build-*/
/target/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.o
*.a
*.so
*.so.*
*.dylib
*.exe
*.dSYM/

# ---- Python（仅离线导出工具，非运行时） ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# ---- Node / 前端 ----
node_modules/
/web/dist/
/dist/
*.tsbuildinfo
.npm/

# ---- 模型与运行时资产（仓外归档） ----
/assets/
/models/
*.onnx
*.engine
*.plan
*.pth
*.pt
*.safetensors
*.ckpt
*.rnnb
*.bin
# 小型对拍夹具可以入库，必须显式列出。
!tests/fixtures/**/*.onnx
!tests/fixtures/**/*.bin

# ---- 音频、视频与交付物 ----
*.wav
*.flac
*.f32
*.mp3
*.m4a
*.mp4
*.mkv
*.pdf
*.pptx
*.docx
*.xlsx
# 小型回归输入可以入库，必须显式列出。
!tests/fixtures/**/*.wav
# pre DSP 对拍夹具（旧 C 核心离线生成，来源与再生命令见 Task 3/4 报告）：
# input.f32 输入信号（合成噪声 + 分段正弦，1 s / 48 kHz 单声道 f32）
!tests/fixtures/dsp/input.f32
# hp.f32 旧 C 高通输出参考（Rust 侧逐位一致验收）
!tests/fixtures/dsp/hp.f32
# wola.f32 旧 C WOLA 降噪输出参考（Rust 侧容差对拍验收）
!tests/fixtures/dsp/wola.f32
# counts.txt 旧 C 每 960 样本块的 WOLA 发射样本数（wrapper 帧对齐验收）
!tests/fixtures/dsp/counts.txt
# gate/agc/limiter/stages.f32 旧 C 整形级单开与全开发射流参考（容差对拍验收）
!tests/fixtures/dsp/gate.f32
!tests/fixtures/dsp/agc.f32
!tests/fixtures/dsp/limiter.f32
!tests/fixtures/dsp/stages.f32
# limiter_hot.f32 旧 C 输入×4 的限幅器介入态参考（input.f32 电平低于 -1 dB 上限，
# 冷输入下限幅器不触发，热输入专门对拍介入路径）
!tests/fixtures/dsp/limiter_hot.f32
# dec.f32 旧 C 打包链 16 kHz PCM 参考（逐位对拍验收）
!tests/fixtures/dsp/dec.f32
# meta.txt 旧 C 打包链每帧 meta 参考（frame_idx/vad/energy/conf/segment 对拍验收）
!tests/fixtures/dsp/meta.txt

# ---- 日志与本地数据 ----
*.log
logs/
*.pid
*.sock
/state/glossary.json
local/

# ---- 编辑器与系统 ----
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- 代理工作区 ----
# SDD 等代理scratch（账本、brief、review 包），不入库。
.superpowers/

# ---- 报告 ----
# reports/ 只跟踪 Markdown。证据文件默认留在本地，仅白名单例外入库。
reports/**/*.wav
reports/**/*.png
reports/**/*.json
reports/**/*.html
reports/**/__pycache__/
